    "/api/v1/godot/games/{game_id}/modifications/{run_id}/events/stream": {
      "get": {
        "description": "SSE replay + tail of one modification run's event log.\n\nModifications take 30s-10min and can drop their HTTP connection at\nany point (refresh, mobile sleep, deploy bounce). The persistent log\nlives at ``<game_path>/.modifications/<run_id>/events.jsonl`` \u2014\nthis endpoint reattaches the client to that log so the modify panel\ncan survive disconnects the same way the create page does.\n\nValidates ``run_id`` is alphanumeric (uuid4().hex[:10] in practice)\nto prevent path-traversal via the run_id segment.",
        "operationId": "stream_modification_events_api_v1_godot_games__game_id__modifications__run_id__events_stream_get",
        "parameters": [
          {
            "in": "path",
            "name": "game_id",
            "required": true,
            "schema": {
              "title": "Game Id",
              "type": "string"
            }
          },
          {
            "in": "path",
            "name": "run_id",
            "required": true,
            "schema": {
              "title": "Run Id",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "since",
            "required": false,
            "schema": {
              "default": -1,
              "title": "Since",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "OAuth2PasswordBearer": []
          }
        ],
        "summary": "Stream Modification Events",
        "tags": [
          "godot"
        ]
      }
    },

    "/api/v1/godot/games/{game_id}/events": {
      "get": {
        "description": "Return the creation-time event log for a game so the UI can replay\nthe build.\n\nThe godot creation agent persists every SSE event to\n``<game_path>/.creation/events.jsonl``. This endpoint serves that file\nparsed as JSON so the frontend can render it with the same components\nused in the live stream view.\n\nReturns ``{\"events\": [...], \"summary\": {...} | null}`` \u2014 summary is\nthe contents of ``.creation/summary.json`` when present (status,\nduration, has_export, etc.).",
        "operationId": "get_game_events_api_v1_godot_games__game_id__events_get",
        "parameters": [
          {
            "in": "path",
            "name": "game_id",
            "required": true,
            "schema": {
              "title": "Game Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "OAuth2PasswordBearer": []
          }
        ],
        "summary": "Get Game Events",
        "tags": [
          "godot"
        ]
      }
    },
    "/api/v1/godot/games/{game_id}/events/stream": {
      "get": {
        "description": "SSE replay + tail of a game's creation log.\n\nThe same shape POST /games returns, but reattachable. Pass\n``?since=N`` to resume after a disconnect (N is the highest ``seq``\nthe client has already seen). Returns 404 if no events.jsonl exists\nfor this id.\n\nDeliberately does NOT require ``game_exists()`` (which checks for\nproject.godot) \u2014 a build that's only seconds in won't have written\nthat file yet, and we still want the reattach to work.",
        "operationId": "stream_game_events_api_v1_godot_games__game_id__events_stream_get",
        "parameters": [
          {
            "in": "path",
            "name": "game_id",
            "required": true,
            "schema": {
              "title": "Game Id",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "since",
            "required": false,
            "schema": {
              "default": -1,
              "title": "Since",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "OAuth2PasswordBearer": []
          }
        ],
        "summary": "Stream Game Events",
        "tags": [
          "godot"
        ]
      }
    },

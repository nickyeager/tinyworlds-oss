  "schemas": {
    "CreateGameRequest": {
      "description": "Request to create a new Godot game.",
      "properties": {
        "budget_cents": {
          "anyOf": [
            {
              "maximum": 10000.0,
              "minimum": 0.0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "description": "Asset generation budget in cents",
          "title": "Budget Cents"
        },
        "description": {
          "description": "Natural language game description",
          "title": "Description",
          "type": "string"
        },
        "reference_image": {
          "anyOf": [
            {
              "$ref": "#/components/schemas/VisualReference"
            },
            {
              "type": "null"
            }
          ]
        },
        "visibility": {
          "default": "public",
          "enum": [
            "public",
            "private",
            "unlisted"
          ],
          "title": "Visibility",
          "type": "string"
        }
      },
      "required": [
        "description"
      ],
      "title": "CreateGameRequest",
      "type": "object"
    },
    "GameInfoResponse": {
      "description": "Game info response.",
      "properties": {
        "can_edit": {
          "default": false,
          "title": "Can Edit",
          "type": "boolean"
        },
        "engine": {
          "default": "godot",
          "title": "Engine",
          "type": "string"
        },
        "game_id": {
          "title": "Game Id",
          "type": "string"
        },
        "game_path": {
          "title": "Game Path",
          "type": "string"
        },
        "has_export": {
          "title": "Has Export",
          "type": "boolean"
        },
        "has_plan": {
          "title": "Has Plan",
          "type": "boolean"
        },
        "has_structure": {
          "title": "Has Structure",
          "type": "boolean"
        },
        "has_video": {
          "title": "Has Video",
          "type": "boolean"
        },
        "name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Name"
        },
        "visibility": {
          "default": "public",
          "title": "Visibility",
          "type": "string"
        }
      },
      "required": [
        "game_id",
        "game_path",
        "has_plan",
        "has_structure",
        "has_video",
        "has_export"
      ],
      "title": "GameInfoResponse",
      "type": "object"
    },
    "HTTPValidationError": {
      "properties": {
        "detail": {
          "items": {
            "$ref": "#/components/schemas/ValidationError"
          },
          "title": "Detail",
          "type": "array"
        }
      },
      "title": "HTTPValidationError",
      "type": "object"
    },
    "ModifyGameRequest": {
      "description": "Request to modify a Godot game with voice or text.",
      "properties": {
        "instruction": {
          "description": "Natural language modification instruction",
          "title": "Instruction",
          "type": "string"
        }
      },
      "required": [
        "instruction"
      ],
      "title": "ModifyGameRequest",
      "type": "object"
    },
    "ModifyGameResponse": {
      "description": "Response from game modification.",
      "properties": {
        "changes": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Changes",
          "type": "array"
        },
        "error": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Error"
        },
        "explanation": {
          "default": "",
          "title": "Explanation",
          "type": "string"
        },
        "success": {
          "title": "Success",
          "type": "boolean"
        }
      },
      "required": [
        "success"
      ],
      "title": "ModifyGameResponse",
      "type": "object"
    },
    "PlaythroughEvent": {
      "description": "One event POSTed from the running WASM game.\n\nFrontend / GDScript autoload composes these with whatever fields are\nrelevant per kind \u2014 we don't enforce a schema beyond a kind string.\nCommon kinds godogen-generated games emit:\n\n  session_start    \u2014 game loaded, player ready; data: {build_id, scene}\n  player_pos       \u2014 sampled every N seconds; data: {x,y,z, ts_session}\n  pickup           \u2014 player picked something up; data: {kind, object_id}\n  interact         \u2014 interact key pressed against a target; data: {target}\n  error            \u2014 caught script error; data: {type, message}\n  session_end      \u2014 beforeunload; data: {duration_s, fps_avg}",
      "properties": {
        "data": {
          "additionalProperties": true,
          "title": "Data",
          "type": "object"
        },
        "kind": {
          "maxLength": 64,
          "title": "Kind",
          "type": "string"
        },
        "session_id": {
          "anyOf": [
            {
              "maxLength": 64,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Session Id"
        }
      },
      "required": [
        "kind"
      ],
      "title": "PlaythroughEvent",
      "type": "object"
    },
    "RenameGameRequest": {
      "description": "Body for PATCH /games/{id}: rename a game's display name.",
      "properties": {
        "name": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        }
      },
      "required": [
        "name"
      ],
      "title": "RenameGameRequest",
      "type": "object"
    }
  }
}

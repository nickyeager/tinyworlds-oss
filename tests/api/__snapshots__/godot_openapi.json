    "/api/v1/godot/games/{game_id}/log": {
      "get": {
        "description": "Return the persisted creation log for a game.\n\nThe pipeline writes every event to .creation/events.jsonl during creation\nand a summary.json on exit (success, partial, failed, or crashed). This\nendpoint surfaces both so failures can be diagnosed after the SSE stream\nhas closed.\n\nArgs:\n    tail: If > 0, only the last N events are returned.",
        "operationId": "get_creation_log_api_v1_godot_games__game_id__log_get",
        "parameters": [
          {
            "in": "path",
            "name": "game_id",
            "required": true,
            "schema": {
              "title": "Game Id",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "tail",
            "required": false,
            "schema": {
              "default": 0,
              "title": "Tail",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "OAuth2PasswordBearer": []
          }
        ],
        "summary": "Get Creation Log",
        "tags": [
          "godot"
        ]
      }
    },

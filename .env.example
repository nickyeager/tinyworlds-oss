# API Keys (Optional - trusted paid asset broker; zero budget uses procedural assets)
XAI_API_KEY=your_xai_key_here
GOOGLE_API_KEY=your_google_gemini_key_here
# Optional remote TRELLIS.2 (trusted launcher only; 25 cents per new GLB).
FAL_KEY=

# API Keys (Optional - for specific features)
OPENAI_API_KEY=your_openai_key_here
DEEPSEEK_API_KEY=your_deepseek_key_here
# ANTHROPIC_API_KEY is NOT needed — Claude is used via Claude Code CLI (subscription).
# Only set this + ENABLE_ANTHROPIC_API=true if you want direct pay-per-token API access.
# ANTHROPIC_API_KEY=your_claude_key_here
ENABLE_ANTHROPIC_API=false
DEEPGRAM_API_KEY=your_deepgram_key_here
GITHUB_TOKEN=your_github_token_here

# Azure Speech (Optional - required only for voice transcription features)
AZURE_SPEECH_KEY=your_azure_speech_key_here
AZURE_SPEECH_REGION=eastus


# FastAPI Backend Configuration
API_V1_PREFIX=/api/v1
PROJECT_NAME=TinyWorlds API
SECRET_KEY=your-secret-key-here-generate-with-openssl-rand-hex-32
ACCESS_TOKEN_EXPIRE_MINUTES=30
DEBUG=false

# Database
DATABASE_URL=sqlite+aiosqlite:///./data/tinyworlds.db
# For PostgreSQL: DATABASE_URL=postgresql+asyncpg://user:password@localhost/tinyworlds

# CORS (Frontend URLs)
CORS_ORIGINS=["http://localhost:3000","http://localhost:3333","http://localhost:5173"]

# Paths
DATABASE_PATH=./data/games.db
CHROMA_PATH=./data/chroma
TEMP_REPOS_PATH=./data/temp_repos

# Settings
EMBEDDING_MODEL=text-embedding-3-small
GODOT_MIN_VERSION=4.0

# Sidecar docker-launcher (security #1). Shared secret between the backend and
# the `sidecar-launcher` service that runs the bevy build and worker docker jobs. Required
# (and must match on both) when bevy or worker execution is enabled.
# Generate with: openssl rand -hex 32
LAUNCHER_TOKEN=your-launcher-token-here-generate-with-openssl-rand-hex-32
# SIDECAR_LAUNCHER_URL defaults to http://sidecar-launcher:8500 (compose
# network). For a host-run dev backend, set http://localhost:8500.
# SIDECAR_LAUNCHER_URL=http://sidecar-launcher:8500

# Generation provider and independent engine selection
GAME_AGENT_PROVIDER=codex
DEFAULT_GAME_ENGINE=godot
AGENT_EXECUTION_MODE=local
# Personal, loopback-only setup at /connect. Disable for shared/hosted instances.
PERSONAL_MODE=true
# Optional private credential directory; default is ~/.local/share/tinyworlds/providers.
PERSONAL_PROVIDER_DIR=
GAME_AGENT_TIMEOUT_SECONDS=1800
# Model name passed to each CLI's --model; blank uses the CLI's default.
# Any name the installed CLI accepts works, including newly released models.
CLAUDE_CLI_MODEL=
CODEX_CLI_MODEL=
# Production only; requires strong signing, launcher and PostgreSQL credentials.
REQUIRE_PRODUCTION_SECRETS=false
# POSTGRES_PASSWORD=replace_with_a_unique_url_safe_password_at_least_16_characters

# Production generated HTML must run on a separate origin from the frontend.
# GAME_PLAY_ORIGIN=https://games.tinyworlds.us
# NEXT_PUBLIC_GAME_PLAY_URL=https://games.tinyworlds.us
# Optional local agent dashboard: docker compose -f docker-compose.observability.yml up -d
# Blank disables exports; these settings belong only on the backend.
AGENT_TRACE_ENDPOINT=
AGENT_TRACE_PROJECT=tinyworlds
AGENT_TRACE_CONTENT=false

# No account receives administrator privileges unless explicitly configured.
ADMIN_EMAILS=

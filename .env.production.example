# ============================================================
# TinyWorlds Production Configuration — Hetzner VPS
# Copy to .env and fill in values
# ============================================================

# === REQUIRED ===
SECRET_KEY=           # Generate: python -c "import secrets; print(secrets.token_urlsafe(64))"
DATABASE_URL=postgresql+asyncpg://tinyworlds:CHANGE_ME@postgres:5432/tinyworlds
POSTGRES_PASSWORD=CHANGE_ME

# === DOMAIN ===
CORS_ORIGINS=["https://tinyworlds.us"]
FRONTEND_URL=https://tinyworlds.us

# === CLAUDE CLI (game generation) ===
CLAUDE_CLI_BINARY=claude

# === ASSET GENERATION (used by Claude CLI tools during game creation) ===
XAI_API_KEY=
GOOGLE_API_KEY=
TRIPO3D_API_KEY=

# === MONITORING (optional) ===
SENTRY_DSN=
DEBUG=false

# === EMAIL (optional) ===
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@example.com  # replace with a sender on your verified Resend domain

# Personal provider connections are for loopback-only, single-user installations.
PERSONAL_MODE=false
